      "css": ".ds-editor{background:var(--background,#0a0a0f);border:1px solid var(--border,#2a2a3a);transition:border-color 150ms,box-shadow 150ms}.ds-editor:focus-within{border-color:var(--accent,#00ff88);box-shadow:var(--shadow-neon-sm,0 0 3px #00ff88,0 0 6px #00ff8830)}.ds-editor label{display:block;padding:16px;border-bottom:1px solid var(--border,#2a2a3a);color:var(--accent,#00ff88);font:12px var(--font-label,monospace)}.ds-editor textarea{display:block;resize:vertical;width:100%;min-height:220px;padding:20px 16px;background:var(--background,#0a0a0f);color:var(--foreground,#e0e0e0);border:0;border-radius:0;font:13px/1.9 var(--font-body,monospace);caret-color:var(--accent,#00ff88)}.ds-editor textarea::placeholder{color:var(--muted-foreground,#a1a4b4);opacity:1}.ds-editor textarea:focus-visible{outline:1px solid var(--ring,#00ff88);outline-offset:-4px}.ds-editor>span{display:block;padding:12px 16px;border-top:1px solid var(--border,#2a2a3a);color:var(--muted-foreground,#a1a4b4);font:11px var(--font-label,monospace)}@media(prefers-reduced-motion:reduce){button,a,textarea{transition-duration:.01ms}}"
