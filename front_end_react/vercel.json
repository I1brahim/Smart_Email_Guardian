{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/scan.py": {
      "maxDuration": 60,
      "includeFiles": "guardian_backend/**",
      "excludeFiles": "{node_modules/**,build/**,src/**,public/**}"
    }
  },
  "rewrites": [
    { "source": "/scan", "destination": "/api/scan" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\""
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
